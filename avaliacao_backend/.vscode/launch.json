{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "TRANSURBAN: API DS + IA",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["backend.main:app", "--host", "127.0.0.1", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "TRANSURBAN: análise do CSV",
      "type": "debugpy",
      "request": "launch",
      "module": "backend.analise",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
