# Copie para backend/.env e preencha com os dados do SEU projeto Supabase.
# Use uma chave secreta somente no backend local. Nunca coloque credenciais no frontend.
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_KEY=sb_secret_EXEMPLO_FICTICIO_NAO_FUNCIONA

# Origens permitidas para o Live Server. Separe várias origens com vírgulas.
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
