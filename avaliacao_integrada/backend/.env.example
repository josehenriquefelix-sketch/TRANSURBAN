# Copie para backend/.env e preencha com os dados do SEU projeto Supabase.
# Use uma chave secreta somente no backend local. Nunca coloque credenciais no frontend.
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_KEY=sb_secret_EXEMPLO_FICTICIO_NAO_FUNCIONA

# Origens permitidas para o Live Server. Separe várias origens com vírgulas.
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# E-mails da equipe com permissão para alterar cidades e linhas.
ADMIN_EMAILS=equipe@exemplo.com
APP_URL=http://127.0.0.1:8000
# Defina true quando usar hospedagem com HTTPS.
COOKIE_SECURE=false

# E-mails de aprovação (motorista e gestão). Preencha para avisar os revisores.
EMAIL_APROVACOES=
# SMTP do backend para notificações. Gmail exige senha de app, não a senha comum.
# O envio de confirmação/recuperação precisa do MESMO SMTP em Supabase > Auth > Email > SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Chave e modelo autorizados do Ollama Cloud. Sem eles, os totais continuam disponíveis.
OLLAMA_API_KEY=
OLLAMA_MODELO=
