{
  "info": {
    "name": "TransUrban - Módulo 6 DS",
    "_postman_id": "transurban-modulo6-fastapi",
    "description": "GET e POST da tabela cidade usando FastAPI, SQLAlchemy, Psycopg e PostgreSQL/Supabase.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "baseUrl", "value": "http://127.0.0.1:8000"}
  ],
  "item": [
    {
      "name": "1 - API raiz",
      "request": {"method": "GET", "url": "{{baseUrl}}/"}
    },
    {
      "name": "2 - Health",
      "request": {"method": "GET", "url": "{{baseUrl}}/health"}
    },
    {
      "name": "3 - GET cidades antes do cadastro",
      "request": {"method": "GET", "url": "{{baseUrl}}/cidades/"}
    },
    {
      "name": "4 - POST cidade de teste",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id_cidade\": 99,\n  \"nome\": \"Cidade Teste Módulo 6\"\n}"
        },
        "url": "{{baseUrl}}/cidades/"
      }
    },
    {
      "name": "5 - GET cidades após POST",
      "request": {"method": "GET", "url": "{{baseUrl}}/cidades/"}
    }
  ]
}
